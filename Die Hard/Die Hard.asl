init
{
    int memSize = modules.First().ModuleMemorySize;
switch (memSize)
{
    case 92479488:
		print("Detected Mednafen 1.32.1");
		version = "1.32.1";
		break;
	case 93294592:
		print("Detected Mednafen 0.9.48");
		version = "0.9.48";
		break;
	case 11714560:
		print("Detected Mesen 0.9.9");
		version = "0.9.9";
		break;
	case 92667904:
		print("Detected Mesen 2.1.1");
		version = "2.1.1";
		break;
	case 8069120:
		print("Detected FCEUX 2.6.6");
		version = "2.6.6";
		break;
	case 2113536:
		print("Detected Nestopia 1.40");
		version = "1.40";
		break;
	case 1974272:
		print("Detected Nestopia 1.52");
		version = "1.52";
		break;
    case 137461760:
		print("Detected Ares 147");
		version = "147";
		break;
	default:
		print("Unknown Emulator");
		version = "";
		break;
}
    vars.start = false;
    vars.detonator = false;
    vars.thirdfloor = true;
    vars.roof = true;
}
start
{
    //if (old.CutsceneID == 0x14 && current.CutsceneID == 0x0B) vars.start = true;
    if (current.CutsceneID == 0x0B && old.start == 0xFF && current.start == 0xF0) 
        {vars.start = false; vars.detonator = false; vars.thirdfloor = true; vars.roof = true; return true;}
}
split
{
    if (settings["Glass"] && old.floor == 0x04 && current.floor == 0x03 && vars.thirdfloor) {vars.thirdfloor = false; return true;}
    if(settings["Gun"])
    {   if (current.floor == 0x02 && ((old.Inventory >> 3) & 1) != 1 && ((current.Inventory >> 3) & 1) == 1) vars.detonator = true;
        if (old.floor == 0x02 && current.floor == 0x03 && vars.detonator) {vars.detonator = false; return true;}}
    if (settings["Door"] && old.floor == 0x06 && current.floor == 0x07 && vars.roof) {vars.roof = false; return true;}
    if (current.floor == 0x07 && old.CutsceneID != 0x16 && current.CutsceneID == 0x16) return true;
}
reset
{
    if (current.floor == 0x00 && current.CutsceneID == 0x18 && current.start == 0x00)
        {vars.start = false; vars.detonator = false; vars.thirdfloor = true; vars.roof = true; return true;}
}
startup
{
    settings.Add("main", false, "AutoSplitter for Die Hard Nes by PakLomak");
	settings.Add("main3", false, "--https://www.twitch.tv/paklomak", "main");
    settings.Add("options", true, "Options");
	settings.Add("Glass", false, "Split by Broke Glass and return 3-d floor", "options");
    settings.Add("Gun", false, "Split by Grab Detonator and return 3-d floor", "options");
    settings.Add("Door", false, "Split by Broke Door and go roof", "options");
}