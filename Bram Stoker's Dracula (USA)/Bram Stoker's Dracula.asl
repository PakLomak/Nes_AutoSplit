		version = "0.0.6";
		break;
	case 8069120:
		print("Detected FCEUX 2.6.6");
		version = "2.6.6";
		break;
	case 2113536:
		print("Detected Nestopia 1.40");
		version = "1.40";
		break;
	case 1974272:
		print("Detected Nestopia 1.52");
		version = "1.52";
		break;
	default:
		print("Unknown Emulator");
		version = "";
		break;
}
}
start
{
    if (old.menu == 0x00 && current.menu == 0x01) vars.start = true;
    if (old.screen == 0x04 && current.screen == 0x00 && vars.start == true) { vars.start = false;
    return true;}
}
split
{
    if (current.level == old.level + 1) return true;
    if (settings["Shadow"] && old.boss == 0x00 && current.boss == 0x02) return true;
    if (settings["bride"] && old.boss == 0x02 && current.boss == 0x04) return true;
    if (settings["Dracula"] && old.boss == 0x04 && current.boss == 0x06) return true;
}
reset
{
    if (current.level == 0x00 && current.menu == 0x00 && current.screen == 0x00 && current.boss == 0x00) return true;
}
startup
{
	refreshRate = 70;
	settings.Add("main", false, "AutoSplitter for Bram Stoker's Dracula (USA) by PakLomak");
	settings.Add("main3", false, "--https://www.twitch.tv/paklomak", "main");
	settings.Add("options", true, "Options");
	settings.Add("Shadow", true, "Split on The Shadow", "options");
	settings.Add("bride", false, "Split by bride", "options");
	settings.Add("Dracula", false, "Split by Dracula", "options");
}