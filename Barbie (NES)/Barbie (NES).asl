init //NES
{
int memSize = modules.First().ModuleMemorySize;
switch (memSize)
{
    case 92479488:
		print("Detected Mednafen 1.32.1");
		version = "1.32.1";
		break;
	case 91533312:
		print("Detected Mednafen 1.29.0");
		version = "1.29.0";
		break;
	case 90116096:
		print("Detected Mednafen 1.27.1");
		version = "1.27.1";
		break;
	case 93294592:
		print("Detected Mednafen 0.9.48");
		version = "0.9.48";
		break;
	case 11714560:
		print("Detected Mesen 0.9.9");
		version = "0.9.9";
		break;
	case 10412032:
		print("Detected Mesen 0.9.8");
		version = "0.9.8";
		break;
	case 10067968:
		print("Detected Mesen 0.9.7");
		version = "0.9.7";
		break;
	case 92667904:
		print("Detected Mesen 2.1.1");
		version = "2.1.1";
		break;
	case 5283840:
		print("Detected Mesen 0.0.6");
		version = "0.0.6";
		break;
	case 8069120:
		print("Detected FCEUX 2.6.6");
		version = "2.6.6";
		break;
	case 2113536:
		print("Detected Nestopia 1.40");
		version = "1.40";
		break;
	case 1974272:
		print("Detected Nestopia 1.52");
		version = "1.52";
		break;
	default:
		print("Unknown Emulator");
		version = "";
		break;
}
	vars.start = false;
	vars.boss1 = false;
	vars.boss2 = false;
	vars.boss3 = false;
	vars.boss4 = false;
	vars.boss5 = false;
	vars.boss6 = false;
	vars.jukebox = false;
}
/*update
{
	print("Level " + current.lvl.ToString("X2"));
	print("Sub Level " + current.subLvl.ToString("X2"));
	print("Boss " + current.boss.ToString("X2"));
	print("Music " + current.MusicSpeed.ToString("X2"));

}*/
start
{
    if (old.lvl == 0x0C && current.lvl == 0x10) vars.start = true;
    if (vars.start == true && current.position == 0x00 && old.show == 0x00 && current.show == 0x01){
        vars.start = false;
		vars.boss1 = true;	vars.boss2 = true;	vars.boss3 = true;	vars.boss5 = true;	vars.boss4 = true;	vars.boss6 = true;
		vars.jukebox = false;
        return true;
    }
}
reset
{
    if (current.lvl == 0x00 && current.show == 0x00 && current.position == 0x00 && current.MusicSpeed == 0x80){
		vars.start = false;
		vars.boss1 = true;	vars.boss2 = true;	vars.boss3 = true;	vars.boss5 = true;	vars.boss4 = true;	vars.boss6 = true;
		vars.jukebox = false;
        return true;
	}
}
split
{
	if (current.lvl == 0x10)
	{ 	if (settings["SubLVL"] && current.subLvl == old.subLvl + 1) return true;
		if (settings["Boss"] && current.subLvl == 0x01 && old.MusicSpeed == 0x61 && current.MusicSpeed == 0x71 && vars.boss1 == true)	{vars.boss1 = false;	return true;}
		if (settings["Boss"] && current.subLvl == 0x02 && old.boss == 0x09 && current.boss == 0x11 && vars.boss2 == true)	{vars.boss2 = false;	return true;}	}
	if (settings["Main_Level"] && old.lvl == 0x10 && current.lvl == 0x05) return true; // Level 2
	if (current.lvl == 0x0E)	
	{	if (settings["SubLVL"] && (old.subLvl == 0x80 || old.subLvl == 0x02) && (current.subLvl == 0x01)) return true;	
		if (settings["SubLVL"] && current.subLvl == old.subLvl + 1) return true;	
		if (settings["Boss"] && current.subLvl == 0x03 && old.MusicSpeed == 0x61 && current.MusicSpeed == 0x71 && vars.boss3 == true)	{vars.boss3 = false;	return true;}	}
	if (settings["Main_Level"] && old.lvl == 0x0E && current.lvl == 0x05) return true; // Level 3
	if (current.lvl == 0x0F)
	{	if (settings["SubLVL"] && old.subLvl == 0x03 && current.subLvl == 0x01) return true;	
		if (settings["Boss"] && old.subLvl == 0x01 && current.subLvl == 0x02 && vars.boss4 == true)	{vars.boss4 = false;	return true;}	}
	if (settings["Main_Level"] && old.lvl == 0x0f && current.lvl == 0x05) return true; // Level 4
	if (current.lvl == 0x0D)
	{	if (settings["Boss"] && old.boss == 0x05 && current.boss == 0x09 && vars.boss5 == true)	{vars.boss5 = false;	return true;}
		if (settings["Boss"] && old.subLvl == 0x02 && current.subLvl == 0x03 && vars.boss6 == true)	{vars.boss6 = false;	return true;}    }
	if (settings["Main_Level"] && old.lvl == 0x0D && current.lvl == 0x05) return true; // Level 5 and Level 6
	if (current.lvl == 0x11)
	{	if (old.subLvl == 0x03 && current.subLvl == 0x01) return true;	}
	if (current.lvl == 0x11 && current.subLvl == 0x01 && current.MusicSpeed == 0x66) vars.jukebox = true;
	if (old.End_lvl == 0x00 && current.End_lvl == 0xEB && vars.jukebox == true)	{	vars.jukebox = false;	return true;	}
}
startup
{
	settings.Add("main", false, "AutoSplitter for Barbie(Nes) by PakLomak");
	settings.Add("main3", false, "--https://www.twitch.tv/paklomak", "main");
	settings.Add("options", true, "Options");
	settings.Add("Main_Level", true, "Split by level", "options");
	settings.Add("SubLVL", true, "Split by sub level", "options");
	settings.Add("Boss", false, "Split by before boss", "options");
}